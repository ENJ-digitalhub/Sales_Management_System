{
  "name": "tx-retailos",
  "version": "1.0.0",
  "description": "TX RetailOS — Offline-first POS, packaged as a Windows desktop app",
  "main": "electron/main.js",
  "author": "ENJ DigitalHub",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "build:backend": "pyinstaller --onefile --name txretailos-backend --distpath backend-dist --workpath build/pyi-work --specpath build start_server.py",
    "build": "npm run build:backend && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.enjdigitalhub.txretailos",
    "productName": "TX RetailOS",
    "asar": true,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "backend/**/*",
      "start_server.py",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "frontend",
        "to": "frontend"
      },
      {
        "from": "backend-dist",
        "to": "backend-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "database",
        "to": "database",
        "filter": [
          "schema.sql",
          "seed.sql"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TX RetailOS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "license": "LICENSE.txt"
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    }
  },
  "allowScripts": {
    "electron@43.1.1": true,
    "electron-winstaller@5.4.0": true
  }
}