# --- Core secrets (required) ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
SECRET_KEY=change-me-to-a-different-long-random-string

# --- Database (optional — defaults to local SQLite file) ---
# DATABASE_URL=sqlite:///database/shop.db

# --- Server ---
FLASK_ENV=development
DEBUG=True
WAITRESS_HOST=0.0.0.0
WAITRESS_PORT=5000
SYNC_ENABLED=False

# --- Default user (auto-created on first run) ---
# Set these before the first launch to control who your admin/default
# account is. If either APP_DEFAULT_USERNAME or APP_DEFAULT_PASSWORD is
# left blank, no default user is created.
APP_DEFAULT_USERNAME=admin
APP_DEFAULT_PASSWORD=change-this-password
APP_DEFAULT_ROLE=admin