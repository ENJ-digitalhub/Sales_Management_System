# --- Core secrets (required) ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
SECRET_KEY=change-me-to-a-different-long-random-string

# --- Database (optional — defaults to local SQLite file) ---
# DATABASE_URL=sqlite:///database/shop.db

# --- Server ---
FLASK_ENV=development
DEBUG=True
WAITRESS_HOST=0.0.0.0
WAITRESS_PORT=5000
SYNC_ENABLED=False

# --- Default user (auto-created on first run) ---
# Leave blank to skip auto-creation. Fill in before first launch (or edit
# the generated .env and restart) to create your login automatically.
APP_DEFAULT_USERNAME=change-this-username
APP_DEFAULT_PASSWORD=change-this-password
APP_DEFAULT_ROLE=admin